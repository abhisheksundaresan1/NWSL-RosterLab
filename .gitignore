# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Cached data (don't commit large/derived data)
data/raw/
data/processed/
*.parquet

# 2026 in-season snapshots ARE committed — they seed movement history and are
# the output the daily GitHub Action commits.
!data/snapshots/
!data/snapshots/*.parquet

# Same for the rolling form windows: the app READS these at render time, so if
# they are not committed the deployed site has no form data at all.
!data/form/
!data/form/*.parquet

# Claude Code session files
.claude/

# OS / editor
.DS_Store
.ipynb_checkpoints/
.vscode/

# Streamlit local secrets (PostHog key etc.) — never commit
.streamlit/secrets.toml
